{
    "folders": [
        {
            "name": "frontend",
            "path": "./frontend",
        },
        {
            "name": "backend",
            "path": "./backend",
        },
        {
            "name": "workspace-root",
            "path": "."
        }
    ],
    "extensions": {
        "recommendations": [
            "svelte.svelte-vscode",
        ]
    },
    "settings": {
        "files.exclude": {
            "**/.git": true,
            "**/.svn": true,
            "**/.hg": true,
            "**/.DS_Store": true,
            "**/Thumbs.db": true,
            "**/.svelte-kit": true,
            "backend/": true,
            "frontend/": true
        },
        "js/ts.experimental.useTsgo": true,
        "elementaryWatson.defaultLocale": "en-US",
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Typecheck (Single Run)",
                "type": "shell",
                "command": "npx tsc --noEmit",
                "problemMatcher": [
                    "$tsc"
                ],
                "group": "build",
                "presentation": {
                    "reveal": "silent",
                    "panel": "shared"
                }
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "type": "node",
                "request": "launch",
                "name": "Run backend yarn script: dev",
                "cwd": "${workspaceFolder:backend}",
                "runtimeExecutable": "yarn",
                "runtimeArgs": [
                    "run",
                    "dev"
                ],
                "console": "integratedTerminal"
            },
            {
                "type": "node-terminal",
                "request": "launch",
                "name": "Run frontend yarn script: dev",
                "cwd": "${workspaceFolder:frontend}",
                "command": "yarn run dev",
            }
        ],
        "compounds": [
            {
                "name": "Run Backend & Frontend",
                "configurations": [
                    "Run backend yarn script: dev",
                    "Run frontend yarn script: dev"
                ]
            }
        ]
    }
}